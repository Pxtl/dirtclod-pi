# ==========================================
# Docker Configuration
# ==========================================

# User ID and Group ID used by the pi-coding-agent container (user: in compose).
#
# Rootless Podman: leave at 1000 — it's the uid/gid baked into the image
#   (agentclod). Run init-shared-group.sh / init-volumes.sh so your host
#   account and the agent share the volumes.
#
# Rooted Docker: set these to your host's uid/gid (`id -u`, `id -g`) so files
#   the agent writes are owned by you on the host. 1000 matches both the image
#   user and the typical single-user Linux host.

AGENT_UID=1000
AGENT_GID=1000

# Authentication - currently unsupported
GITHUB_TOKEN=ghp_exampleexampleexample

# Git identity - this is a part you must override
GIT_NAME=user-name-goes-here
GIT_EMAIL=1234567890+user-name-goes-here@users.noreply.github.com

# Commit Signings
GIT_GPG_KEY=DEADBEEF
GIT_GPG_SIGN=false

SSHITMAIDS_DEST=git@github.com:22
SSHITMAIDS_CLIENT_DEST=git@sshitmaids:22
SSHITMAIDS_PUBLIC_PORT=2222
SSHITMAIDS_GENERATE_CLIENT_CONFIG=false
SSHITMAIDS_DO_KEYSCAN=false

# Persist config in WebUI
ENABLE_PERSISTENT_CONFIG=False

# HuggingFace token - only needed for *gated* model repos (or to avoid
# anonymous rate limits).  Public repos download anonymously; leave blank.
HF_TOKEN=

# llama.cpp server port (host side; 9931 is llama-server's default)
LLAMA_PUBLIC_PORT=9931

# OPTIONAL: restrict the llama server to specific CUDA cards.  By default
# CUDA sees all GPUs and llama.cpp balances across them.  Uncomment and set
# to pin (e.g. "0"), and add the same line to the llama service environment
# in docker-compose.yaml.
# LLM_AGENT_CUDA_DEVICES=0

# Model selection lives in the router preset: volumes/llama/models.ini
# (seeded from initcontent/llama-defaults/).  Edit there to swap quants -
# current picks for a 19GB-VRAM budget:
#   dirtclod-agent-qwen:      Qwen3.8-27B-UD-IQ4_XS  (14.3GB, full GPU)
#   dirtclod-north-mini-code: North-Mini-Code-1.0-UD-Q5_K_M (22.95GB file,
#                             MoE: experts in system RAM via n-cpu-moe)
#   dirtclod-autocomplete-qwen: Qwen2.5-Coder-1.5B Q4_K_M (always resident)
LLM_AGENT_CTX=65536
# Autocomplete model (small coder model)
LLM_AUTOCOMPLETE_HF_REPO=Qwen/Qwen2.5-Coder-1.5B-Instruct-GGUF:Q4_K_M